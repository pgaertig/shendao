<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= current_page.data.title %> - ShenDao</title>
  <meta name="description" content="<%= current_page.data.description %>"/>
  <meta name="keywords" content="<%= current_page.data.keywords %>"/>
  <meta name="author" content="ShenDao"/>
  <meta name="robots" content="index, follow"/>
  <meta property="og:site_name" content="ShenDao Akupunktura Poznań" />
  <meta property="og:type" content="<%= current_page.data.date_published ? 'article' : 'website' %>" />
  <meta property="og:url" content="https://shendao.poznan.pl<%= current_page.url %>" />
  <meta property="og:title" content="<%= current_page.data.title %> | Blog | ShenDao" />
  <meta property="og:description" content="<%= current_page.data.description %>" />
  <meta property="og:image" content="https://shendao.poznan.pl/img/shendao-icon256.png" />
  <link rel="stylesheet" href="/css/style2026.css" />
  <link rel="icon" type="image/png" href="/img/shendao-icon256.png">
  <!--link rel="icon" type="image/svg+xml" href="/logo2.svg"-->
  <meta name="geo.region" content="PL-WP" />
  <meta name="geo.placename" content="Poznań" />
  <link rel="canonical" href="https://shendao.poznan.pl<%= current_page.url %>" />
  <link rel="preload" href="/logo2.svg" as="image" />
<% if current_page.data.date_published %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "<%= current_page.data.title %>",
      "description": "<%= current_page.data.description %>",
      "url": "https://shendao.poznan.pl<%= current_page.url %>",
      "datePublished": "<%= current_page.data.date_published %>",
      "dateModified": "<%= current_page.data.date_published %>",
      "author": { "@id": "https://shendao.poznan.pl/#person" },
      "publisher": { "@id": "https://shendao.poznan.pl/#business" }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://shendao.poznan.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://shendao.poznan.pl/blog/" },
        { "@type": "ListItem", "position": 3, "name": "<%= current_page.data.title %>" }
      ]
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MedicalWebPage",
      "name": "<%= current_page.data.title %>",
      "description": "<%= current_page.data.description %>",
      "url": "https://shendao.poznan.pl<%= current_page.url %>",
      "about": {
        "@type": "MedicalTherapy",
        "name": "Akupunktura"
      },
      "author": { "@id": "https://shendao.poznan.pl/#person" },
      "publisher": { "@id": "https://shendao.poznan.pl/#business" }
    }
  </script>
<% end %>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9WL49ZGYL9"></script>
  <script>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-9WL49ZGYL9');
          function gtag_report_conversion(url) {
                  var callback = function () {
                          if (typeof(url) != 'undefined') {
                                  window.location = url;
                          }
                  };
                  gtag('event', 'conversion', {
                          'send_to': ['AW-1041470776/35tWCJiVxoIaELiqzvAD'],
                          'event_callback': callback
                  });
                  return false;
          }
  </script>
</head>
<body>
<header class="site-header">
  <nav class="site-nav" aria-label="Menu główne">
    <a class="site-nav__brand" href="/">
      <img class="site-nav__logo" src="/logo2.svg" alt="ShenDao" width="90" height="90" />
      <span class="site-nav__title">Akupunktura &middot; Poznań</span>
    </a>
    <button class="site-nav__toggle" type="button" aria-controls="site-menu" aria-expanded="false" aria-label="Rozwiń menu">
      <span class="site-nav__toggle-icon"></span>
    </button>
    <div class="site-nav__menu" id="site-menu">
      <ul class="site-nav__list">
        <li><a class="site-nav__link" href="/blog/">Blog</a></li>
        <li><a class="site-nav__link" href="/">Gabinet Akupunktury</a></li>
      </ul>
      <a id="mtel" href="tel:600704120" class="site-nav__cta btn btn-primary gtag"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone" viewBox="0 0 16 16">
        <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"></path>
      </svg> 600 704 120</a>
    </div>
  </nav>
</header>
<div class="page">
  <main class="blog-layout">
    <article class="blog-article">
<% if current_page.data.date_published %>
      <h1><%= current_page.data.title %></h1>
<% if current_page.data.subtitle %>
      <h2 class="blog-article__subtitle"><%= current_page.data.subtitle %></h2>
<% end %>
  <%
    pl_months = %w[stycznia lutego marca kwietnia maja czerwca lipca sierpnia września października listopada grudnia]
    d = Date.parse(current_page.data.date_published.to_s)
    date_str = "#{d.day} #{pl_months[d.month - 1]} #{d.year}"
  %>
      <p class="blog-article__date">Opublikowano: <%= date_str %></p>
<% end %>
<%= yield %>
    </article>

    <aside class="blog-sidebar">
      <section class="blog-cta">
        <p class="blog-cta__lead">
          Masz pytania lub chcesz umówić się na wizytę? Zadzwoń lub wyślij wiadomość:
        </p>
        <%= partial('partials/contact_buttons') %>
      </section>
      <section class="blog-disclaimer">
        <p>
          Informacja prawna: Treści zawarte w tym wpisie mają charakter wyłącznie informacyjny i edukacyjny. Nie stanowią one porady medycznej i nie powinny być używane jako podstawa do diagnozowania lub leczenia żadnych schorzeń. Zawsze konsultuj się z lekarzem przed rozpoczęciem jakiejkolwiek nowej terapii lub w przypadku jakichkolwiek pytań dotyczących stanu zdrowia. Autor nie ponosi odpowiedzialności za jakiekolwiek działania lub zaniechania podjęte na podstawie informacji zawartych w tym wpisie.
        </p>
      </section>
    </aside>
  </main>

  <footer class="site-footer">
    <p>&copy; 2026 ShenDao | <a href="/">ShenDao - Akupunktura - Poznań</a></p>
  </footer>
</div>

<script defer="defer">
        document.addEventListener("click", function (event) {
                var menu = document.getElementById("site-menu");
                if (!menu) return;
                var toggle = event.target.closest(".site-nav__toggle");
                if (toggle) {
                        var open = menu.classList.toggle("is-open");
                        toggle.setAttribute("aria-expanded", open ? "true" : "false");
                } else if (event.target.closest(".site-nav__link") || event.target.closest(".site-nav__brand")) {
                        menu.classList.remove("is-open");
                        var btn = document.querySelector(".site-nav__toggle");
                        if (btn) btn.setAttribute("aria-expanded", "false");
                }
        });

        // gtag with href value as param if gtag method is available
        if (typeof gtag === 'function') {
                document.querySelectorAll('.gtag').forEach((el) => {
                        el.addEventListener('click', () => {
                                try{
                                        //get id of element
                                        navigator.sendBeacon('/touch.json?a=' + el.id);
                                        return gtag_report_conversion(el.href);
                                } catch (e) {
                                        console.error('gtag', e);
                                }
                        });
                });
                console.log('gtag installed');
        } else {
                console.log('gtag not available');
        }

</script>
</body>
</html>